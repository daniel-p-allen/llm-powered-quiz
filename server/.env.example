# Copy this file to .env and fill in your own key. .env is gitignored and must
# never be committed; this template is the only version that belongs in the repo.
#
#   cp .env.example .env
#
# A free key from https://console.groq.com/keys is enough to run the whole demo.
# Groq's free tier allows 30 requests a minute, which is far more than this needs.
# Keys look like gsk_...

GROQ_API_KEY=gsk_your_key_here

# Only needed to run variants/main-huggingface-router.py, which calls Hugging Face
# instead. Note that Hugging Face free accounts get $0.10 of inference credit a
# month, so that path stops working quickly — see server/README.md.
# HF_API_TOKEN=hf_your_token_here
